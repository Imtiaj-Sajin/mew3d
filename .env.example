# Copy this file to .env and fill in your real key.
# The LLM powers the smart agents (analysis, prompt enhancement, vision critics).
# Everything still works without it - agents fall back to heuristics.
OPENAI_API_KEY="sk-..."
# Optional: any OpenAI-compatible endpoint instead of api.openai.com
# (e.g. a local LLM: http://localhost:11434/v1 for Ollama)
# OPENAI_BASE_URL="http://localhost:11434/v1"
LLM_MODEL="gpt-4o-mini"

# Groq (free tier at console.groq.com) - web UI Narrator agent + prompt guardrail
GROQ_API_KEY="gsk_..."
GROQ_MODEL="openai/gpt-oss-120b"

# Gemini - optional image generation
GEMINI_API_KEY=""

# Access key for the web studio (required by `serve --public`)
MEW3D_ACCESS_TOKEN=""

# Optional remote texture server (see scripts/colab_texture_server.ipynb)
MEW3D_TEXTURE_URL=""
